# MySQL / app data source
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=marketing

# CRM integrations
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=replace_me
HUBSPOT_ACCESS_TOKEN=replace_me

# Optional OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=marketing-fastapi

# Durable GenAI storage
CAMPAIGNFORGE_STORAGE_ROOT=./data/generated
CAMPAIGNFORGE_RETENTION_DAYS=30

# Hosted auth / workspace controls
CAMPAIGNFORGE_AUTH_MODE=disabled
CAMPAIGNFORGE_DASHBOARD_AUTH_MODE=disabled
CAMPAIGNFORGE_DEFAULT_WORKSPACE_ID=local-demo
CAMPAIGNFORGE_DEFAULT_WORKSPACE_NAME=Local demo workspace
CAMPAIGNFORGE_DEFAULT_API_KEY=campaignforge-demo-key
CAMPAIGNFORGE_DEFAULT_USER_ID=local-operator
CAMPAIGNFORGE_DEFAULT_REQUEST_LIMIT_PER_HOUR=60
CAMPAIGNFORGE_DASHBOARD_USERNAME=operator
CAMPAIGNFORGE_DASHBOARD_PASSWORD=change-me

# Hosted CampaignForge app (production must provide these explicitly)
CAMPAIGNFORGE_ENV=development
DATABASE_URL=sqlite:///data/generated/campaignforge-hosted.sqlite3
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_REGION=europe-west2
GCS_ASSET_BUCKET=replace-with-private-bucket
CLOUD_TASKS_QUEUE=campaignforge-agent-runs
CLOUD_TASKS_WORKER_URL=https://replace-with-cloud-run-worker-url
CAMPAIGNFORGE_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Low-cost AI defaults. Tests and local demos continue to use mock adapters.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
CAMPAIGNFORGE_MONTHLY_AI_BUDGET_MINOR=2000
CAMPAIGNFORGE_IMAGE_MAX_PER_RUN=2

# Vercel web app; Firebase client values are public identifiers, not secrets.
NEXT_PUBLIC_CAMPAIGNFORGE_API_URL=http://localhost:8000
CAMPAIGNFORGE_API_URL=http://localhost:8000
CAMPAIGNFORGE_WORKSPACE_ID=local-demo
# Explicitly enable development identity headers when testing a production web build locally.
CAMPAIGNFORGE_WEB_AUTH_MODE=development
CAMPAIGNFORGE_DEV_USER_ID=local-owner
CAMPAIGNFORGE_DEV_ROLE=owner
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
